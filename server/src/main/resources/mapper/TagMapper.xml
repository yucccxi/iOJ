<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="me.iynotuo.judge.problem.mapper.TagMapper">

    <select id="findAll" resultType="me.iynotuo.judge.problem.entity.Tag">
        SELECT id, name FROM tags ORDER BY name
    </select>

    <select id="findById" resultType="me.iynotuo.judge.problem.entity.Tag">
        SELECT id, name FROM tags WHERE id = #{id}
    </select>

    <select id="findByName" resultType="me.iynotuo.judge.problem.entity.Tag">
        SELECT id, name FROM tags WHERE name = #{name}
    </select>

    <insert id="insert" parameterType="me.iynotuo.judge.problem.entity.Tag"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tags (name) VALUES (#{name})
    </insert>

    <select id="findByProblemId" resultType="me.iynotuo.judge.problem.entity.Tag">
        SELECT t.id, t.name
        FROM tags t
        JOIN problem_tags pt ON pt.tag_id = t.id
        WHERE pt.problem_id = #{problemId}
        ORDER BY t.name
    </select>

    <select id="findByProblemIds" resultType="me.iynotuo.judge.problem.mapper.ProblemTagRow">
        SELECT pt.problem_id AS problem_id, t.id AS id, t.name AS name
        FROM problem_tags pt
        JOIN tags t ON t.id = pt.tag_id
        WHERE pt.problem_id IN
        <foreach collection="problemIds" item="problemId" open="(" separator="," close=")">#{problemId}</foreach>
        ORDER BY t.name
    </select>

    <delete id="deleteProblemTags">
        DELETE FROM problem_tags WHERE problem_id = #{problemId}
    </delete>

    <insert id="insertProblemTags">
        INSERT INTO problem_tags (problem_id, tag_id) VALUES
        <foreach collection="tagIds" item="tagId" separator=",">(#{problemId}, #{tagId})</foreach>
    </insert>

</mapper>
