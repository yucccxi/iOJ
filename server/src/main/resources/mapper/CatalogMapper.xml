<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="me.iynotuo.judge.problem.mapper.CatalogMapper">

    <!--
      One UNION ALL of the two problem scopes. Both branches expose the same columns so the outer
      query can sort/page once:
        kind       LOCAL / EXTERNAL
        ref_id     problems.id or external_problems.id
        code       external rows only (NULL for local rows); short id from the original OJ
        difficulty both kinds; external rows derive it from their rating
        time       external rows only (NULL for local rows); China time (UTC+8)
        url        external rows only (NULL for local rows)
        counts     both kinds (local rows count locally, external rows carry imported numbers)
      Filters are applied inside each branch so the indexes on problems / external_problems can be
      used; tag filtering goes through the branch's own junction table.
    -->
    <sql id="unionBody">
        SELECT 'LOCAL' AS kind,
               p.id AS ref_id,
               p.title AS title,
               CAST(NULL AS CHAR(32)) AS code,
               p.difficulty AS difficulty,
               NULL AS time,
               p.rating AS rating,
               p.scope_id AS scope_id,
               s.name AS scope_name,
               CAST(NULL AS CHAR(512)) AS url,
               p.submit_count AS submit_count,
               p.accepted_count AS accepted_count,
               p.author_id AS author_id,
               u.nickname AS author_nickname,
               p.created_at AS created_at,
               p.updated_at AS sort_time
        FROM problems p
        LEFT JOIN scopes s ON s.id = p.scope_id
        JOIN users u ON u.id = p.author_id
        WHERE p.status = 'PUBLISHED'
        <if test="criteria.scopeIds != null and criteria.scopeIds.size() > 0">
            AND p.scope_id IN
            <foreach collection="criteria.scopeIds" item="scopeId" open="(" separator="," close=")">
                #{scopeId}
            </foreach>
        </if>
        <if test="criteria.keyword != null and criteria.keyword != ''">
            AND p.title LIKE CONCAT('%', #{criteria.keyword}, '%')
        </if>
        <if test="criteria.difficulties != null and criteria.difficulties.size() > 0">
            AND p.difficulty IN
            <foreach collection="criteria.difficulties" item="difficulty" open="(" separator="," close=")">
                #{difficulty}
            </foreach>
        </if>
        <if test="criteria.rating != null">
            AND p.rating = #{criteria.rating}
        </if>
        <if test="criteria.minRating != null">
            AND p.rating &gt;= #{criteria.minRating}
        </if>
        <if test="criteria.maxRating != null">
            AND p.rating &lt;= #{criteria.maxRating}
        </if>
        <if test="criteria.tagIds != null and criteria.tagIds.size() > 0">
            <choose>
                <when test="criteria.matchAllTags">
                    AND (SELECT COUNT(DISTINCT pt.tag_id) FROM problem_tags pt
                         WHERE pt.problem_id = p.id
                           AND pt.tag_id IN
                           <foreach collection="criteria.tagIds" item="tagId" open="(" separator="," close=")">
                               #{tagId}
                           </foreach>) = #{criteria.tagCount}
                </when>
                <otherwise>
                    AND EXISTS (SELECT 1 FROM problem_tags pt
                                WHERE pt.problem_id = p.id
                                  AND pt.tag_id IN
                                  <foreach collection="criteria.tagIds" item="tagId" open="(" separator="," close=")">
                                      #{tagId}
                                  </foreach>)
                </otherwise>
            </choose>
        </if>
        UNION ALL
        SELECT 'EXTERNAL' AS kind,
               e.id AS ref_id,
               e.title AS title,
               e.code AS code,
               e.difficulty AS difficulty,
               e.time AS time,
               e.rating AS rating,
               e.scope_id AS scope_id,
               s.name AS scope_name,
               e.url AS url,
               e.submit_count AS submit_count,
               e.accepted_count AS accepted_count,
               NULL AS author_id,
               CAST(NULL AS CHAR(32)) AS author_nickname,
               e.created_at AS created_at,
               e.time AS sort_time
        FROM external_problems e
        JOIN scopes s ON s.id = e.scope_id
        WHERE 1 = 1
        <if test="criteria.scopeIds != null and criteria.scopeIds.size() > 0">
            AND e.scope_id IN
            <foreach collection="criteria.scopeIds" item="scopeId" open="(" separator="," close=")">
                #{scopeId}
            </foreach>
        </if>
        <if test="criteria.keyword != null and criteria.keyword != ''">
            AND e.title LIKE CONCAT('%', #{criteria.keyword}, '%')
        </if>
        <if test="criteria.difficulties != null and criteria.difficulties.size() > 0">
            AND e.difficulty IN
            <foreach collection="criteria.difficulties" item="difficulty" open="(" separator="," close=")">
                #{difficulty}
            </foreach>
        </if>
        <if test="criteria.rating != null">
            AND e.rating = #{criteria.rating}
        </if>
        <if test="criteria.minRating != null">
            AND e.rating &gt;= #{criteria.minRating}
        </if>
        <if test="criteria.maxRating != null">
            AND e.rating &lt;= #{criteria.maxRating}
        </if>
        <if test="criteria.tagIds != null and criteria.tagIds.size() > 0">
            <choose>
                <when test="criteria.matchAllTags">
                    AND (SELECT COUNT(DISTINCT et.tag_id) FROM external_problem_tags et
                         WHERE et.external_problem_id = e.id
                           AND et.tag_id IN
                           <foreach collection="criteria.tagIds" item="tagId" open="(" separator="," close=")">
                               #{tagId}
                           </foreach>) = #{criteria.tagCount}
                </when>
                <otherwise>
                    AND EXISTS (SELECT 1 FROM external_problem_tags et
                                WHERE et.external_problem_id = e.id
                                  AND et.tag_id IN
                                  <foreach collection="criteria.tagIds" item="tagId" open="(" separator="," close=")">
                                      #{tagId}
                                  </foreach>)
                </otherwise>
            </choose>
        </if>
    </sql>

    <select id="findPage" resultType="me.iynotuo.judge.problem.mapper.CatalogRow">
        SELECT c.kind, c.ref_id, c.title, c.code, c.difficulty, c.time, c.rating, c.scope_id, c.scope_name, c.url,
               c.submit_count, c.accepted_count, c.author_id, c.author_nickname, c.created_at
        FROM ( <include refid="unionBody"/> ) c
        <choose>
            <when test="criteria.sort == 'RATING'">
                ORDER BY COALESCE(c.rating, -1)
                <if test="criteria.sortAscending">ASC</if>
                <if test="!criteria.sortAscending">DESC</if>,
                c.kind, c.ref_id DESC
            </when>
            <when test="criteria.sort == 'ACCEPTED'">
                ORDER BY c.accepted_count
                <if test="criteria.sortAscending">ASC</if>
                <if test="!criteria.sortAscending">DESC</if>,
                c.kind, c.ref_id DESC
            </when>
            <when test="criteria.sort == 'SUBMISSIONS'">
                ORDER BY c.submit_count
                <if test="criteria.sortAscending">ASC</if>
                <if test="!criteria.sortAscending">DESC</if>,
                c.kind, c.ref_id DESC
            </when>
            <when test="criteria.sort == 'ACCEPTANCE_RATE'">
                ORDER BY
                    CASE WHEN c.submit_count = 0 THEN 1 ELSE 0 END ASC,
                    CASE WHEN c.submit_count = 0 THEN 0
                         ELSE c.accepted_count * 1.0 / c.submit_count END
                    <if test="criteria.sortAscending">ASC</if>
                    <if test="!criteria.sortAscending">DESC</if>,
                    c.kind, c.ref_id DESC
            </when>
            <otherwise>
                ORDER BY
                    CASE WHEN c.sort_time IS NULL THEN 1 ELSE 0 END ASC,
                    c.sort_time
                    <if test="criteria.sortAscending">ASC</if>
                    <if test="!criteria.sortAscending">DESC</if>,
                    c.kind, c.ref_id DESC
            </otherwise>
        </choose>
        LIMIT #{criteria.limit} OFFSET #{criteria.offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM ( <include refid="unionBody"/> ) c
    </select>

</mapper>
