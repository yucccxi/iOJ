<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="me.iynotuo.judge.problem.mapper.ExternalProblemTagMapper">

    <select id="findByExternalProblemIds"
            resultType="me.iynotuo.judge.problem.mapper.ExternalProblemTagRow">
        SELECT et.external_problem_id AS external_problem_id, t.id AS id, t.name AS name
        FROM external_problem_tags et
        JOIN tags t ON t.id = et.tag_id
        WHERE et.external_problem_id IN
        <foreach collection="externalProblemIds" item="externalProblemId" open="(" separator="," close=")">
            #{externalProblemId}
        </foreach>
        ORDER BY t.name
    </select>

    <delete id="deleteByTagId">
        DELETE FROM external_problem_tags WHERE tag_id = #{tagId}
    </delete>

</mapper>
